# Copy to /etc/deadmon/env on the instance, mode 0640, owned by root:deadmon.
# The unit marks this EnvironmentFile optional (-), so the service runs fine when
# the file is absent: tracing falls back to the local JSON sink and the
# dashboard trace links still resolve.
#
# Only read when BOTH the key is set AND the `neatlogs` package is importable.
NEATLOGS_API_KEY=