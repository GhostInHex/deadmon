[Unit]
Description=deadmon - one crawl run, then the dashboard
Documentation=https://github.com/neathack/deadmon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deadmon
Group=deadmon
WorkingDirectory=/opt/deadmon

# Secrets live here, not in the unit file: 0600, owned by root, readable by the
# service user. Only NEATLOGS_API_KEY is read today; the file may stay empty and
# tracing falls back to the local sink.
EnvironmentFile=-/etc/deadmon/env

# Bind 0.0.0.0 because the dashboard is served, not just crawled. The crawl runs
# first and the page fills from what it stored, so the port only opens once
# there is something to show.
Environment=DEADMON_HOST=0.0.0.0
Environment=DEADMON_PORT=8080
Environment=DEADMON_DB=/var/lib/deadmon/deadmon.db
Environment=DEADMON_TRACES=/var/lib/deadmon/traces
Environment=PYTHONUNBUFFERED=1

# --reset is deliberately NOT here. A durable service that wipes its history on
# every boot is a demo, not a deployment: run rows are append-only (ticket 05)
# and that history is the evidence the dashboard exists to show. To record a
# fresh demo, run `deadmon-crawl --reset --no-serve` first, then start the unit.
ExecStart=/opt/deadmon/venv/bin/deadmon-crawl --host 0.0.0.0 --port 8080 \
          --db /var/lib/deadmon/deadmon.db --traces /var/lib/deadmon/traces

# /api/feed is what the Vercel-hosted Next.js app reads. Read-only, so a
# wildcard CORS origin is safe here; the app has no accounts (ADR-0020).

Restart=on-failure
RestartSec=5

# This is a read-only HTTP server over a local SQLite file. Everything below
# keeps a parse bug from becoming anything wider.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/deadmon

StandardOutput=journal
StandardError=journal
SyslogIdentifier=deadmon

[Install]
WantedBy=multi-user.target