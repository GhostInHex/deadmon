# ---- Raw screen recordings (only the cut matters) ----------------------
*.mov
*.mkv
*.flv
*.avi
*.wmv
*.m4v
*.screenflow/
.obs/
recordings/
"Screen Recording"*

# =========================================================================
# KEEP - the hackathon evidence set. Negations win over anything above.
# (PLAN.md (evidence checklist)-64 evidence checklist, "judges explicitly ask for these")
# =========================================================================

# .scratch/ is the issue tracker of record (docs/agents/issue-tracker.md)
# with Status lines, comments and answers appended over time - unversioned
# it is worthless. A broad scratch* rule in a template would eat it.
!.scratch/

# Fixtures: the versioned, never-overwritten known-good corpus
# (ADR-0015:5,11; docs/PRD.md (Test seams),125). This is the test corpus and the
# Slice 4 validation target - it must survive.
!fixtures/
!fixtures/**

# Adapter allowlist declarations are source code (ADR-0018:13)
!scraper/allowlists/
!scraper/allowlists/**

# Evidence: trace screenshots, entire-graph, the demo video
# (PLAN.md (evidence checklist)-64, docs/SPONSORS.md (Entire)). Never a blanket *.png / *.mp4 rule -
# these are 25% of the marks.
!docs/evidence/
!docs/evidence/**

# cfo.ai business plan - path is fixed at docs/docs/SPONSORS.md (cfo.ai section)
!docs/business-plan.md

# Lockfiles and requirements are code
!requirements*.txt
!pyproject.toml
