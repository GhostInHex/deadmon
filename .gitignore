# deadmon
# Docs-only today; the Python build (Slice 1+) lands on Oct 10-12.
# Rules are written so the hackathon evidence artifacts stay COMMITTED.

# ---- Design system -------------------------------------------------------
# docs/design-system-reference/ is the token source of record for the UI
# (ADR-0020). apps/web/src/app/tokens.css is a verbatim copy; keep them in
# step. The .tsx reference files are Paper-flavoured and are not compiled.

# ---- Secrets (docs/LLM_ACCESS.md (key + budget section), docs/SPONSORS.md (Entire section)) -------------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
secrets.yaml
secrets.yml

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- Virtualenvs ---------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
__pypackages__/

