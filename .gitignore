*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
deadmon*.db
data/deadmon*.db

# ---- HTTP / page cache ("cache aggressively", docs/PRD.md (Scraping posture)) ---------------
cache/
.cache/
http_cache/
requests_cache.sqlite

# ---- Logs (heal log is a DB view, docs/PRD.md (Story 19, heal log)-60) ------------------------
logs/
*.log
nohup.out
*.stackdump
core

# ---- Runtime output: runs, snapshots, backfill scratch -----------------
# fixtures/ is NOT here - see the KEEP block at the bottom.
snapshots/
runs/
out/
output/
artifacts/
tmp/
temp/
work/
.runs/

# ---- Heal loop working files -------------------------------------------
# The diff lives on the heal event (ADR-0014:18), not in the repo.
*.diff
*.patch
heals/*.patch
proposals/*.patch
*.bak
*.orig
*.rej

# ---- Scheduler locks / pids -------------------------------------------
*.pid
heal.lock
scheduler.lock
.scout.lock

