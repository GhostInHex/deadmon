# Copy to .env (gitignored) and fill in. Loaded into your shell before running:
#   PowerShell:  Get-Content .env | Where-Object { $_ -match '=' } | ForEach-Object {
#                  $k,$v = $_ -split '=',2; Set-Item -Path "Env:$k" -Value $v }
#
# Neatlogs project key. Read only when the `neatlogs` package is importable;
# without it every crawl run is traced to the local JSON sink instead and the
# dashboard trace links still resolve.
NEATLOGS_API_KEY=

# Shared LiteLLM gateway key (neatHack models page; one key per team, $20/30d
# shared). Read by Slice 4's heal proposer as the Bearer token for
# https://litellm.vision.aivar.app/v1. Absent key: the proposer refuses with
# a clear error and the crawl pipeline is unaffected (no model call sits on
# the crawl path). See docs/LLM_ACCESS.md. Never paste this into chat.
LITELLM_API_KEY=

# Telegram bot token from BotFather (Slice 3 alerts). Read by the dispatcher
# only; without it the dispatcher refuses and the crawl pipeline is
# unaffected. Fake-sink tests prove the timing logic with no token at all.
TELEGRAM_BOT_TOKEN=