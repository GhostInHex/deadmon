root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# 23 of 28 markdown files currently lack a final newline - this is the
# single biggest source of "\ No newline at end of file" churn.
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true

# Python: the Slice 1+ language (docs/SPONSORS.md:60-62)
[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2
